rules_version = '2';

// Clients never write game-economy data directly: purchases, wallets, chat
// messages and reports go through the Cloud Functions (Admin SDK bypasses
// these rules). Clients may only read what concerns them.
service cloud.firestore {
  match /databases/{db}/documents {

    // Server-owned wallet (gems, entitlements). Read-only for its owner.
    match /wallets/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Granted purchases, keyed by Play purchase token (idempotent grants).
    match /purchases/{token} {
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Chat: readable by signed-in users who passed the age gate (custom
    // claim set by the server); only the server writes.
    match /messages/{id} {
      allow read: if request.auth != null
        && request.auth.token.online == true;
      allow write: if false;
    }

    match /reports/{id} {
      allow read, write: if false;
    }

    // Weekly leaderboards and ghosts (v2): readable by everyone signed in,
    // written by the server after replay verification.
    match /boards/{board}/entries/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
