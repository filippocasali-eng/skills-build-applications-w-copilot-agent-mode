# BattleQuiz environment variables. Copy to .env.local for development.
# NEVER commit real values. NEVER prefix server secrets with NEXT_PUBLIC_.

# PostgreSQL connection (Supabase: Project Settings → Database → connection string, pooler, port 6543).
# Leave empty to use the in-memory LOCAL DEVELOPMENT store (data lost on restart).
DATABASE_URL=
DATABASE_POOL_MAX=5

# Signs the guest identity cookie. Required in production. Generate with: openssl rand -hex 32
GUEST_COOKIE_SECRET=

# Demo deployments only: allow running without DATABASE_URL / GUEST_COOKIE_SECRET in production mode.
BATTLEQUIZ_ALLOW_MEMORY_STORE=false

# Only for `npm test`: a DISPOSABLE database whose public schema is dropped and recreated.
TEST_DATABASE_URL=

# --- Reserved for later milestones (not used by the current build) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=        # server only
# ANTHROPIC_API_KEY=                # server only, Milestone 5
# STRIPE_SECRET_KEY=                # server only, test mode, Milestone 6
# STRIPE_WEBHOOK_SECRET=            # server only
